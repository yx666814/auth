# --- TEMPLATE ONLY -----------------------------------------------------------
# The values below are placeholders. Do not apply this file as-is.
#
# Generate the real Secret with:
#
#   kubectl -n enterprise-auth create secret generic app-secrets \
#     --from-literal=POSTGRES_USER=auth \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=JWT_SECRET_KEY="$(openssl rand -base64 48)" \
#     --from-literal=SMTP_USER="smtp-user" \
#     --from-literal=SMTP_PASSWORD="smtp-password" \
#     --from-literal=SMTP_FROM_EMAIL="no-reply@example.com" \
#     --from-literal=FRONTEND_URL="https://auth.example.com" \
#     --from-literal=SMTP_HOST="smtp.example.com" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# ...or manage it with Sealed Secrets / External Secrets and keep this file
# out of version control. JWT_SECRET_KEY must be at least 32 characters;
# the application refuses to start without one when DEBUG is false.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: enterprise-auth
  labels:
    app.kubernetes.io/name: enterprise-auth
type: Opaque
stringData:
  POSTGRES_USER: auth
  POSTGRES_PASSWORD: CHANGE_ME_POSTGRES_PASSWORD
  JWT_SECRET_KEY: CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
  SMTP_HOST: smtp.example.com
  SMTP_USER: ""
  SMTP_PASSWORD: ""
  SMTP_FROM_EMAIL: no-reply@example.com
  # Used both for CORS and for the link in verification emails.
  FRONTEND_URL: https://auth.example.com
