# --- TEMPLATE ONLY -----------------------------------------------------------
# The values below are placeholders. Do not apply this file as-is.
#
# Access tokens are signed RS256: the *private* key lives in this Secret and is
# never published, while the public half is derived from it at start-up and
# served at /api/auth/jwks so other systems can verify tokens without being
# able to forge them.
#
# Generate the real Secret with:
#
#   ./scripts/generate-jwt-key.sh          # writes secrets/jwt-private.pem
#
#   kubectl -n enterprise-auth create secret generic app-secrets \
#     --from-literal=POSTGRES_USER=auth \
#     --from-literal=POSTGRES_PASSWORD="$(openssl rand -base64 24)" \
#     --from-file=JWT_PRIVATE_KEY=secrets/jwt-private.pem \
#     --from-literal=JWT_KEY_ID=auth-1 \
#     --from-literal=SMTP_USER="smtp-user" \
#     --from-literal=SMTP_PASSWORD="smtp-password" \
#     --from-literal=SMTP_FROM_EMAIL="no-reply@example.com" \
#     --from-literal=FRONTEND_URL="https://auth.example.com" \
#     --from-literal=SMTP_HOST="smtp.example.com" \
#     --dry-run=client -o yaml | kubectl apply -f -
#
# ...or manage it with Sealed Secrets / External Secrets and keep this file
# out of version control.
#
# During a key rotation, add the retired public key under
# JWT_PREVIOUS_PUBLIC_KEYS as a JSON object (kid -> PEM) so tokens it signed
# keep verifying until they expire. The application refuses to start without a
# signing key when DEBUG is false.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: enterprise-auth
  labels:
    app.kubernetes.io/name: enterprise-auth
type: Opaque
stringData:
  POSTGRES_USER: auth
  POSTGRES_PASSWORD: CHANGE_ME_POSTGRES_PASSWORD
  # The whole PEM, newlines included. `stringData` keeps them literal; if you
  # write it from `--from-literal`, escape each newline as \n — the application
  # restores them.
  JWT_PRIVATE_KEY: |
    CHANGE_ME_RUN_SCRIPTS_GENERATE_JWT_KEY_SH_AND_PASTE_THE_PEM_HERE
  JWT_KEY_ID: auth-1
  SMTP_HOST: smtp.example.com
  SMTP_USER: ""
  SMTP_PASSWORD: ""
  SMTP_FROM_EMAIL: no-reply@example.com
  # Used both for CORS and for the link in verification emails.
  FRONTEND_URL: https://auth.example.com
